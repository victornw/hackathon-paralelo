# Copie para .env e preencha. Nunca commite o .env nem o código de resgate da Featherless.

# LLM (Featherless, API compatível com a OpenAI)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Modelo principal para todos os papéis e fallback quando ele falha.
MODELO_PRINCIPAL=Qwen/Qwen3.8-27B
MODELO_FALLBACK=Qwen/Qwen3.8-Flash-Next
# Opcional: sobrescreve o principal num papel. Visão só roda com MODELO_VISAO definido.
MODELO_EXTRACAO=
MODELO_VISAO=
MODELO_DECISAO=
MODELO_REDACAO=
MODELO_PENDENCIA=

# Tracing e custo (sem preço configurado, o custo fica 0)
DB_PATH=data/app.db
# Preço de referência de mercado (OpenRouter, Qwen3-32B via SiliconFlow, US$/milhão de tokens); os créditos Featherless do evento não têm tarifa pública.
# Câmbio: PTAX de venda do Banco Central em 06/11/2026.
LLM_PRECO_ENTRADA_USD_MTOK=0.14
LLM_PRECO_SAIDA_USD_MTOK=0.57
USD_BRL=5.5013

# Portal simulado e prazos
RELOGIO_INICIO=
FERIADOS_UF=
DOCS_DIR=data/docs
