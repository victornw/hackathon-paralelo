# Copie para .env e preencha. Nunca commite o .env nem o código de resgate da Featherless.

# LLM (Featherless, API compatível com a OpenAI)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Modelo por papel. Papel sem modelo fica indisponível (o agente cai no caminho sem LLM).
MODELO_EXTRACAO=
MODELO_VISAO=
MODELO_DECISAO=
MODELO_REDACAO=
MODELO_PENDENCIA=

# Tracing e custo (sem preço configurado, o custo fica 0)
DB_PATH=data/app.db
LLM_PRECO_ENTRADA_USD_MTOK=
LLM_PRECO_SAIDA_USD_MTOK=
USD_BRL=

# Portal simulado e prazos
RELOGIO_INICIO=
FERIADOS_UF=CE
DOCS_DIR=data/docs
